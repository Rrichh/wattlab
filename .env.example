# ─── Server ───
PORT=3000
NODE_ENV=development

# ─── Database (SQLite — file locale) ───
DATABASE_URL=./wattlab.db

# ─── Auth (CAMBIA QUESTI SECRET IN PRODUZIONE) ───
JWT_ACCESS_SECRET=change-me-with-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=another-long-random-string-different-from-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── CORS ───
# URL del client (es. dove gira l'index.html)
# Per testare in locale aprendo il file: aggiungi null e file://
CORS_ORIGIN=http://localhost:8080,http://localhost:5173,null

# ─── Admin ───
ADMIN_EMAIL=piana.richh@gmail.com

# ─── Cookies ───
COOKIE_SECRET=yet-another-strong-random-string
COOKIE_DOMAIN=
COOKIE_SECURE=false
